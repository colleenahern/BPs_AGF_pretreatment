# ── Run ancombc2 ──────────────────────────────────────────────────────────────
run_ancombc2 <- function(ps, formula, group = NULL, alpha = 0.05) {
  ancombc2(
    data          = ps,
    tax_level     = "Genus",
    fix_formula   = formula,
    rand_formula  = NULL,
    p_adj_method  = "holm",
    pseudo_sens   = TRUE,
    prv_cut       = 0.10,
    lib_cut       = 1000,
    s0_perc       = 0.05,
    group         = group,
    struc_zero    = !is.null(group),
    neg_lb        = !is.null(group),
    alpha         = alpha,
    n_cl          = 1,
    verbose       = TRUE,
    global        = TRUE,
    pairwise      = TRUE,
    dunnet        = TRUE,
    trend         = FALSE,
    iter_control  = list(tol = 1e-5, max_iter = 100, verbose = FALSE),
    em_control    = list(tol = 1e-5, max_iter = 100),
    lme_control   = lme4::lmerControl(),
    mdfdr_control = list(fwer_ctrl_method = "holm", B = 100)
  )
}

# ── Label samples as "A" (control) or "B" (treatment) ────────────────────────
add_newgroup <- function(ps, treatment_level) {
  ps@sam_data$Newgroup <- ifelse(
    ps@sam_data$Testcond == treatment_level, "B", "A"
  )
  ps
}

# ── Extract significant rows and tidy column names ────────────────────────────
#   coef_col = exact column name, e.g. "TestcondCA film + S3 + AS" or "NewgroupB"
#   label    = short label for renaming, e.g. "CAS3AS_v_CAAS"
extract_sig <- function(res, coef_col, label, q_thresh = 0.05) {
  q_col   <- paste0("q_",           coef_col)
  rob_col <- paste0("diff_robust_", coef_col)
  
  sig      <- res[res[[q_col]]   <  q_thresh, ]
  keep_cols <- c("taxon", grep(coef_col, names(res), value = TRUE, fixed = TRUE))
  sig_filt  <- sig[, keep_cols]
  names(sig_filt) <- gsub(coef_col, label, names(sig_filt), fixed = TRUE)
  
  list(sig = sig_filt)
}

# ── Load phyloseq, rename metadata, subset to film, strip " film" ─────────────
load_film_ps <- function(features, tree, taxonomy, metadata) {
  ps <- qza_to_phyloseq(
    features = file.path(BASE, features),
    tree     = file.path(BASE, tree),
    taxonomy = file.path(BASE, taxonomy),
    metadata = file.path(BASE, metadata)
  )
  names(ps@sam_data) <- c("Target", "Experiment", "Test", "TestCond", "AF",
                          "Timepoint", "Time", "Replicate", "Group", "Condition")
  ps_film <- subset_samples(ps, Experiment == "BP_Film")
  ps_film@sam_data$Condition <- gsub(" film", "", ps_film@sam_data$Condition)
  ps_film
}

# ── Run NMDS and return plot ───────────────────────────────────────────────────
nmds_theme <- theme_classic() +
  theme(
    text         = element_text(size = 12),
    plot.title   = element_text(size = 14, hjust = 0.5, face = "bold"),
    axis.title   = element_text(size = 12),
    axis.text    = element_text(size = 12),
    legend.title = element_text(size = 12, face = "bold", vjust = -2),
    legend.text  = element_text(size = 12)
  )

run_nmds <- function(ps_film, title) {
  ps_prop <- transform_sample_counts(ps_film, function(otu) otu / sum(otu))
  ord     <- ordinate(ps_prop, method = "NMDS", distance = "bray")
  plot_ordination(ps_prop, ord, color = "Condition", shape = "Time", title = title) +
    geom_point(size = 3) +
    nmds_theme
}

# ── Run PERMANOVA + betadisper ─────────────────────────────────────────────────
run_permanova <- function(ps_sub, group_var) {
  otu_mat <- as(otu_table(ps_sub), "matrix")
  if (taxa_are_rows(ps_sub)) otu_mat <- t(otu_mat)
  meta     <- data.frame(sample_data(ps_sub))
  dist_mat <- vegdist(otu_mat, method = "bray")
  list(
    adonis     = adonis2(dist_mat ~ meta[[group_var]]),
    betadisper = anova(betadisper(dist_mat, meta[[group_var]]))
  )
}

